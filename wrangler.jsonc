{
  "name": "voidborntools",
  "compatibility_date": "2026-08-01",
  "main": "src/api-worker.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // Arbitrator slot sheets (see src/api-worker.ts). Create the database once
  // with `npx wrangler d1 create voidborn` and paste its id below.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "voidborn",
      "database_id": "5049b182-5496-461e-a328-07859497e08d"
    }
  ]
}
